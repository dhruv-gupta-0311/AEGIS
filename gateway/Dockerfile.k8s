# Kubernetes variant of the gateway image: React is built in stage 1 and baked
# into nginx, so no shared docker-compose volume is needed.
# Build from the REPO ROOT:  docker build -f gateway/Dockerfile.k8s -t aegis-gateway .

# Stage 1: build the React app
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --prefer-offline
COPY frontend/ ./
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Stage 2: serve it with the existing gateway config
FROM nginx:1.27-alpine
COPY gateway/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
